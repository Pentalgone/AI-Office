# GigaChat credentials (required for the current LLM provider)
GIGACHAT_CREDENTIALS=replace_with_your_gigachat_authorization_key

# Yandex Cloud Search API (required only for Analyst web search)
YANDEX_SEARCH_API_KEY=replace_with_your_yandex_search_api_key
YANDEX_FOLDER_ID=replace_with_your_yandex_folder_id

# GitHub Developer integration (required only for automatic code changes)
# Use a fine-grained token limited to this repository:
# Contents: Read and write; Pull requests: Read and write; Actions: Read-only.
GITHUB_TOKEN=replace_with_fine_grained_github_token
GITHUB_REPOSITORY=Pentalgone/AI-Office
GITHUB_BASE_BRANCH=ai-office-upgrade
